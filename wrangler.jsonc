{
  // ==========================================================================
  // 投稿站 · Cloudflare Workers 配置
  //
  // 部署在 submit.宇宙奶龙大学.com（独立子域名，和主站分开）
  //
  // ⚠️ Worker 的 name 必须和主站那个不同，否则会互相覆盖部署。
  // ==========================================================================
  "name": "nailong-submit",
  "compatibility_date": "2026-10-14",

  // 静态资源：public/ 目录直接发；src/worker.js 处理 /api/*
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Worker 入口。有它的时候请求先走 Worker，
  // 非 /api/* 的路径在 worker.js 里交回 env.ASSETS。
  "main": "src/worker.js",

  // 绑到 submit 子域名。
  // custom_domain: true 让 Cloudflare 自动建 DNS 记录 + 证书，
  // 不用手工去 DNS 面板加 CNAME。
  // 前提：xn--psszg58cydsdq780c.com 已经是 Cloudflare 上的 zone（主站迁 NS 时已经满足）。
  "routes": [
    {
      "pattern": "submit.xn--psszg58cydsdq780c.com",
      "custom_domain": true
    }
  ],

  // 本地开发默认端口
  "dev": {
    "port": 8788
  },

  // ==========================================================================
  // 环境变量
  //
  // GITHUB_CLIENT_ID 是**公开值** —— 它会出现在授权链接里
  // （https://github.com/login/oauth/authorize?client_id=...），
  // 任何人打开授权页都能看到。写在这里是为了每次部署自动带上，
  // 不用手工去 Dashboard 配。
  //
  // ⚠️ GITHUB_CLIENT_SECRET 绝不能写在这里！
  //    它一旦进 git 就等于公开，别人能拿它冒充这个应用。
  //    用命令配，存进 Cloudflare 的加密存储：
  //        npx wrangler secret put GITHUB_CLIENT_SECRET
  //    或者在 Dashboard → Worker → Settings → Variables and Secrets 里
  //    加一条，类型选 Secret。
  // ==========================================================================
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23lixg2nDUNSnqhIwn"
  },

  "observability": {
    "enabled": true
  }
}
