{
  // ==========================================================================
  // 投稿站 · Cloudflare Workers 配置
  //
  // 部署在 submit.宇宙奶龙大学.com（独立子域名，和主站分开）
  //
  // ⚠️ Worker 的 name 必须和主站那个不同，否则会互相覆盖部署。
  // ==========================================================================
  "name": "nailong-submit",
  "compatibility_date": "2026-10-15",

  // 静态资源：public/ 目录直接发；src/worker.js 处理 /api/*
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Worker 入口。有它的时候请求先走 Worker，
  // 非 /api/* 的路径在 worker.js 里交回 env.ASSETS。
  "main": "src/worker.js",

  // R2：存待审的图片和投稿元数据。
  // ★ 所有来自访客的数据都先落在这里，绝不直接进仓库 ——
  //   必须管理员在 review 页审核通过后，才由小号写进仓库。
  "r2_buckets": [
    {
      "binding": "SUBMIT_BUCKET",
      "bucket_name": "nailong-submissions",
      "preview_bucket_name": "nailong-submissions-preview"
    },
    {
      "binding": "RATE_BUCKET",
      "bucket_name": "nailong-rate",
      "preview_bucket_name": "nailong-rate-preview"
    }
  ],

  // 绑到 submit 子域名。
  // custom_domain: true 让 Cloudflare 自动建 DNS 记录 + 证书，
  // 不用手工去 DNS 面板加 CNAME。
  // 前提：xn--psszg58cydsdq780c.com 已经是 Cloudflare 上的 zone。
  "routes": [
    {
      "pattern": "submit.xn--psszg58cydsdq780c.com",
      "custom_domain": true
    }
  ],

  // ==========================================================================
  // 明文变量（不是秘密，可以进 git）
  // ==========================================================================
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23lixg2nDUNSnqhIwn",

    // 允许进管理页的 GitHub 用户名。
    // 放明文而不是 secret：它就是你的用户名，仓库里到处都是（README、
    // 提交记录、PR 链接），不算秘密。真正的安全边界是「能不能通过 OAuth
    // 认证成这个人」，那一步由服务端校验，白名单比对在这里做。
    "ADMIN_LOGIN": "Thomas455",

    // 同一个 IP 两次投稿的最小间隔（秒）。默认 30 分钟。
    "RATE_LIMIT": "1800"
  },

  // ==========================================================================
  // ⚠️ 秘密变量：用 wrangler secret put 配，不要写进这个文件
  // ==========================================================================
  //   GITHUB_CLIENT_SECRET   OAuth Client Secret
  //                         （还用于给会话 cookie 和小号 token 加密）
  //
  //   SCT_SENDKEY           Server酱 的 sendkey（sctp<uid>t... 开头）
  //                         有人投稿时给你发微信。只要这一个，uid 包含在里面。
  //                         ⚠️ 等于「谁能给你发消息」的钥匙，泄露了别人就能骚扰你
  //
  //   npx wrangler secret put GITHUB_CLIENT_SECRET
  //   npx wrangler secret put SCT_SENDKEY
  //
  // 小号 token **不在这里** —— 它由管理页「绑定小号」走 OAuth 换到，
  // 加密后存进 R2（见 src/bot.js）。
  //
  // 以前还需要 BOT_TOKEN / TURNSTILE_SECRET，现在都不需要了。

  // 本地开发默认端口
  "dev": {
    "port": 8788
  },

  "observability": {
    "enabled": true
  }
}